DATABASE_URL=postgresql+psycopg2://consent_app:CHANGE_ME@db.internal:5432/ivr_consent

# Rotating PHONE_HMAC_KEY requires rehashing every data_principal row.
# Set to a long random secret. The app does not reject an empty value yet.
PHONE_HMAC_KEY=
# Key-encryption key for name/email at rest (AES-256-GCM envelope encryption).
# Development only: production wraps data keys with a real KMS instead.
# Set to a long random secret. The app does not reject an empty value yet.
ATTRIBUTE_KEY=

UCM_BASE_URL=https://ucm.internal

# Mumbai cluster. api.exotel.com is Singapore and is the default for new
# accounts -- check which one yours is on before setting this.
EXOTEL_BASE_URL=https://api.in.exotel.com
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# --- Twilio (used outside India; Twilio has no India region) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
# Read the en-IN / hi-IN voice names off the Twilio Console; do not guess.
TWILIO_VOICE=
TWILIO_LANGUAGE=en-IN
TWILIO_ENFORCE_SIGNATURE=true

# The externally visible origin. Twilio signs the URL it requested, so behind
# a TLS-terminating proxy this must be the https:// origin or every signature
# check fails.
PUBLIC_BASE_URL=https://consent.datasafeguard.ai

# --- Sprinklr (IVR flow calls /sprinklr/* from HTTP nodes) ---
# Every HTTP node sends "Authorization: Bearer <token>". Unset rejects all.
SPRINKLR_WEBHOOK_TOKEN=

# Sprinklr REST API (us -> Sprinklr), OAuth 2.0 code grant. Key and secret come
# from dev.sprinklr.com -> My Account -> Applications. SPRINKLR_ENV is the
# instance's "sentry-environment" (prod, prod0, prod2, ...); "spr-uat" is a
# placeholder until there is an instance. The redirect URI must match the
# app's Callback URL exactly.
SPRINKLR_API_KEY=
SPRINKLR_API_SECRET=
SPRINKLR_ENV=spr-uat
SPRINKLR_REDIRECT_URI=https://localhost:8088/sprinklr/oauth/callback
SPRINKLR_API_BASE=https://api3.sprinklr.com
# Off until a live instance exists: token refresh in app.jobs and call lookup.
SPRINKLR_API_ENABLED=false

DEFAULT_PROVIDER=exotel
EXOTEL_CALLER_ID=

# Recordings and write-once daily digests written by `python -m app.jobs`.
EVIDENCE_DIR=var/evidence

# Dev only: the console runs on the Vite port during development.
CORS_ORIGINS=http://localhost:5173
